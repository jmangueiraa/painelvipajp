{
  "name": "App do Motorista",
  "short_name": "Motorista",
  "description": "Rotas e entregas do dia para o motorista.",
  "id": "/motorista",
  "start_url": "/motorista",
  "scope": "/motorista",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0F172A",
  "theme_color": "#22C55E",
  "icons": [
    { "src": "/portal-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/portal-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/portal-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/portal-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
